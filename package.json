{
  "name": "@civnir/dsh-image-studio",
  "version": "1.0.0",
  "description": "Image generation studio panel for DeepSeek Harness, backed by SiliconFlow image models.",
  "license": "MIT",
  "author": "civnir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civnir/dsh-image-studio.git"
  },
  "homepage": "https://github.com/civnir/dsh-image-studio#readme",
  "bugs": {
    "url": "https://github.com/civnir/dsh-image-studio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "image-generation",
    "text-to-image",
    "siliconflow"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
